---
const { title, intro, stat, items } = Astro.props;
---
<section class="px-5 py-16">
  <div class="mx-auto max-w-2xl">
    <h2 class="reveal text-center font-display text-3xl font-bold md:text-4xl">{title}</h2>
    <p class="reveal mt-6 text-center text-sm leading-relaxed">{intro}</p>
    <div class="reveal mt-8 flex items-center gap-4 border-t border-white/15 pt-6">
      <span class="grid size-10 place-items-center rounded-lg bg-white/10 text-brand" aria-hidden="true">★</span>
      <span class="text-sm font-semibold">{stat}</span>
    </div>
    <ul>
      {items.map((t: any) => (
        <li class="reveal mt-8 border-t border-white/15 pt-8">
          <p class="text-center text-sm text-white/60">{t.label}</p>
          <blockquote class="mt-4 text-2xl italic leading-snug">{t.quote}</blockquote>
          <p class="mt-6 font-semibold">{t.name}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
