---
import Button from './Button.astro';
const { title = 'Ready to talk?', text = 'Placeholder text inviting the visitor to get in touch.' } = Astro.props;
---
<section class="border-t border-white/10 px-5 py-20 text-center">
  <h2 class="reveal font-display text-3xl font-bold md:text-4xl">{title}</h2>
  <p class="reveal mx-auto mt-4 max-w-xl text-white/70">{text}</p>
  <div class="reveal mt-8"><Button href="/contact">Contact us</Button></div>
</section>
