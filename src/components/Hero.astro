---
import Button from './Button.astro';
const { title, text, cta } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="relative flex min-h-svh flex-col justify-end overflow-hidden bg-neutral-900">
  <video class="absolute inset-0 size-full object-cover" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
    <source src={`${base}/video/hero_video.mp4`} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-10 pt-28">
    <h1 class="reveal font-display text-4xl font-extrabold italic leading-tight text-brand md:text-6xl">{title}</h1>
    <p class="reveal mt-5 max-w-2xl text-base leading-relaxed text-white md:text-lg">{text}</p>
    <div class="reveal mt-8">
      <Button href={cta.href}>{cta.label} <span aria-hidden="true">↗</span></Button>
    </div>
  </div>
</section>
