---
const { title, summary, href } = Astro.props;
---
<a href={href} class="reveal block rounded-2xl border border-white/10 p-6 transition hover:border-brand">
  <h3 class="font-display text-xl font-bold">{title}</h3>
  <p class="mt-3 text-white/70">{summary}</p>
  <span class="mt-4 inline-block text-brand">Learn more →</span>
</a>
