---
const { eyebrow, title, items } = Astro.props;
---
<section class="px-5 py-16">
  <div class="mx-auto max-w-2xl">
    <p class="reveal text-center text-xs font-semibold uppercase tracking-wider">{eyebrow}</p>
    <h2 class="reveal mt-4 text-center font-display text-3xl font-bold md:text-4xl">{title}</h2>
    <div class="mt-8">
      {items.map((it: any) => (
        <details class="reveal group border-b border-white/15 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl font-bold [&::-webkit-details-marker]:hidden">
            {it.q}
            <span class="grid size-6 shrink-0 place-items-center rounded bg-brand text-black" aria-hidden="true">
              <span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span>
            </span>
          </summary>
          <p class="mt-4 leading-relaxed text-white/80">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
