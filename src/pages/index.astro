---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { site } from '../data/site';

const trust = ['Placeholder: years of experience', 'Placeholder: coverage area', 'Placeholder: key benefit'];
const steps = [
  { title: 'Tell us what you need', text: 'Dummy text for step one.' },
  { title: 'We plan the work', text: 'Dummy text for step two.' },
  { title: 'Your fleet keeps moving', text: 'Dummy text for step three.' },
];
---
<Layout title={`${site.name} | Fleet maintenance`} description="Placeholder description for the home page.">
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-2 md:py-28">
    <div>
      <h1 class="reveal font-display text-4xl font-bold md:text-6xl">{site.tagline}</h1>
      <p class="reveal mt-6 text-lg text-white/70">Dummy text describing what the business does and who it helps. Replace with the client's own words.</p>
      <div class="reveal mt-8 flex flex-wrap gap-4">
        <Button href="/contact">Get your custom quote</Button>
        <a href="/services" class="self-center text-brand">See services →</a>
      </div>
    </div>
    <ImagePlaceholder label="Hero image" class="reveal" />
  </section>

  <section class="border-y border-white/10 px-5 py-8">
    <ul class="mx-auto flex max-w-6xl flex-col gap-3 md:flex-row md:justify-between">
      {trust.map((t) => <li class="reveal text-white/80"><span class="text-brand">✓</span> {t}</li>)}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="reveal font-display text-3xl font-bold md:text-4xl">What we do</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {services.map((s) => <ServiceCard title={s.title} summary={s.summary} href={`/services/${s.slug}`} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20">
    <h2 class="reveal font-display text-3xl font-bold md:text-4xl">How it works</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="reveal rounded-2xl bg-white/5 p-6">
          <span class="font-display text-3xl font-bold text-brand">{i + 1}</span>
          <h3 class="mt-3 text-xl font-bold">{s.title}</h3>
          <p class="mt-2 text-white/70">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <CtaBand />
</Layout>
