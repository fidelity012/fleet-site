---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TextBlock from '../components/TextBlock.astro';
import Button from '../components/Button.astro';
import ServiceImageCard from '../components/ServiceImageCard.astro';
import Benefits from '../components/Benefits.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import { hero, textBlocks, servicesIntro, benefits, testimonials, faq } from '../data/home';
---
<Layout title={`${site.name} | Fleet maintenance`} description="Placeholder description for the home page." overlayHeader>
  <Hero {...hero} />

  <section>
    <TextBlock {...textBlocks[0]} />
    <TextBlock {...textBlocks[1]} />
    <div class="reveal pb-12 text-center">
      <Button href="/plans">Pricing plan <span aria-hidden="true">↗</span></Button>
    </div>
  </section>

  <section>
    <TextBlock {...textBlocks[2]}>
      <Button slot="cta" href="/contact">Contact Us <span aria-hidden="true">↗</span></Button>
    </TextBlock>
  </section>

  <section class="bg-neutral-900 px-5 py-16">
    <div class="mx-auto max-w-2xl text-center">
      <p class="reveal text-xs font-semibold uppercase tracking-wider">{servicesIntro.eyebrow}</p>
      <h2 class="reveal mt-4 font-display text-3xl font-bold md:text-4xl">{servicesIntro.title}</h2>
    </div>
    <div class="mx-auto mt-10 grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => <ServiceImageCard title={s.title} summary={s.summary} href={`/services/${s.slug}`} />)}
    </div>
  </section>

  <Benefits {...benefits} />
  <Testimonials {...testimonials} />
  <Faq {...faq} />
</Layout>
