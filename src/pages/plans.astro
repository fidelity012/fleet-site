---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
const plans = [
  { name: 'Plan one', text: 'Dummy description of the first plan.', items: ['Placeholder feature', 'Placeholder feature', 'Placeholder feature'] },
  { name: 'Plan two', text: 'Dummy description of the second plan.', items: ['Placeholder feature', 'Placeholder feature', 'Placeholder feature'] },
];
---
<Layout title="Plans | BRAND NAME" description="Placeholder description for the plans page.">
  <section class="mx-auto max-w-6xl px-5 py-20">
    <h1 class="reveal font-display text-4xl font-bold md:text-5xl">Plans</h1>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {plans.map((p) => (
        <div class="reveal rounded-2xl border border-white/10 p-8">
          <h2 class="font-display text-2xl font-bold">{p.name}</h2>
          <p class="mt-3 text-white/70">{p.text}</p>
          <ul class="mt-6 space-y-2">{p.items.map((i) => <li><span class="text-brand">✓</span> {i}</li>)}</ul>
          <div class="mt-8"><Button href="/contact">Get a quote</Button></div>
        </div>
      ))}
    </div>
  </section>
</Layout>
